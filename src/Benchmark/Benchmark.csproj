<Project Sdk="Microsoft.NET.Sdk">

  <!-- Benchmarks of the library as it is in this repository: the "current" side of the comparison.
       Benchmark.Baseline compiles the same sources against the last published package. See Benchmark.ps1. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForkForward.Mapper\ForkForward.Mapper.csproj" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sources do not name the library's namespace: Benchmark.Baseline compiles them against the previous
         release, whose namespace may differ. Each project supplies its own. -->
    <Using Include="ForkForward.Mapper" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ForkForward.Mapper.QueryableExtensions" />
    <Using Include="ForkForward.Mapper.Internal" />
  </ItemGroup>
</Project>
