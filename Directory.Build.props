<Project>

  <PropertyGroup>
    <!-- Who publishes this fork. The original authors are credited in Copyright, in the package description and in NOTICE.md. -->
    <Authors>ForkForward</Authors>
    <Company>ForkForward</Company>
    <Product>ForkForward.Mapper (fork of AutoMapper)</Product>
    <Copyright>Copyright (c) 2010 Jimmy Bogard and AutoMapper contributors. Modifications copyright (c) 2026 ForkForward contributors.</Copyright>
    <!-- All build output goes to /artifacts instead of bin and obj folders next to each project:
         artifacts/bin/<project>/<configuration>, artifacts/obj/<project>, artifacts/package/<configuration>. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Features>strict</Features>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Reflection"/>
    <Using Include="System.Diagnostics"/>
    <Using Include="System.ComponentModel"/>
    <Using Include="System.Linq.Expressions"/>
  </ItemGroup>
  <!-- The library's own namespaces are declared per project, not here: Benchmark.Baseline, and the helper
       project BenchmarkDotNet generates next to it, compile against the previous release, whose namespace
       may differ. -->
</Project>
